# BLS.Hosting configuration
# Copy to .env  setup.bat does this for you
# .env must never be committed

# Panel bind address and port. Keep 127.0.0.1 so only the reverse proxy can reach it
BLS_HOST=127.0.0.1
BLS_PORT=3300

# Public origin used for secure cookies and CSP
BLS_PUBLIC_URL=https://bls.blociapps.com

# Root folder that holds everything on the VPS
BLS_ROOT=C:\bls

# Session secret. setup.bat generates a random one
BLS_SECRET=change-me-to-64-random-hex-chars

# Session lifetime in minutes
BLS_SESSION_MINUTES=720

# Port range handed out to deployments
BLS_PORT_MIN=3400
BLS_PORT_MAX=3499

# RAM in MB kept for the operating system and the panel itself
BLS_RAM_RESERVE_MB=1536

# Allow allocating more RAM than the host currently has free
BLS_ALLOW_OVERCOMMIT=true

# Max upload size in MB for deployment archives
BLS_MAX_UPLOAD_MB=256

# Initial access codes seeded on first run only
BLS_SEED_ADMIN_CODE=Wplm9-c15!
BLS_SEED_VIEWER_CODE=WmoY7-c12!
