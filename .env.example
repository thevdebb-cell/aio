# ── Discord ─────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID
CLIENT_ID=
# Your main guild ID (Star Customs). Slash commands deploy here instantly.
GUILD_ID=1548048791721082991

# ── Storage ─────────────────────────────────────────────
# STORE_DRIVER = "supabase" (recommended) or "sqlite" (local file)
STORE_DRIVER=sqlite

# Only needed when STORE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Bucket used to store submitted order files (zip/images)
SUPABASE_BUCKET=orders

# ── Download links ──────────────────────────────────────
# How long (minutes) an order download link stays valid
DOWNLOAD_LINK_TTL_MINUTES=10

# ── Bloxlink (verification) — added later ───────────────
BLOXLINK_API_KEY=
