# ── Discord ─────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID
CLIENT_ID=
# Your main guild ID (Star Customs). Slash commands deploy here instantly.
GUILD_ID=1548048791721082991

# ── Storage ─────────────────────────────────────────────
# STORE_DRIVER = "supabase" (recommended) or "sqlite" (local file)
STORE_DRIVER=sqlite

# Only needed when STORE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Bucket used to store submitted order files (zip/images)
SUPABASE_BUCKET=orders

# ── Files / download links ──────────────────────────────
# FILE_DRIVER = "local" (built-in download server) or "supabase" (Storage signed URLs)
FILE_DRIVER=local
# How long (minutes) an order download link stays valid
DOWNLOAD_LINK_TTL_MINUTES=10
# Local driver only: port for the built-in download server
DOWNLOAD_PORT=8787
# Local driver only: public base URL that reaches DOWNLOAD_PORT
# (on bot-hosting.net use the domain/port they give you)
DOWNLOAD_PUBLIC_URL=http://localhost:8787
# Local driver only: stable HMAC secret so links survive a restart
DOWNLOAD_SECRET=

# ── Netlify download site (optional) ────────────────────
# When set, delivery links point at your Netlify site (recommended with Supabase).
# Example: https://star-customs-orders.netlify.app
# The site's DOWNLOAD_SECRET env must match DOWNLOAD_SECRET above.
SITE_BASE_URL=

# ── Bloxlink (verification) — added later ───────────────
BLOXLINK_API_KEY=
